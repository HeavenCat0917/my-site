---
const { title = "我的网站" } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav>
        <a href="/">首页</a > |
        <a href="/blog">文章</a > |
        <a href="/projects">作品</a > |
        <a href="/poem">诗歌</a >
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>© 2026 Website owned by HeavenCat0917</p >
    </footer>
  </body>
</html>

<style>
  html,
body {
  margin: 0;
  width: 100%;
  min-height: 100%;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
    "Microsoft YaHei", sans-serif;
  color: #1a1a1a;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  line-height: 1.7;
}

header {
  padding: 1rem 2rem;
  background: #fff;
  border-bottom: 1px solid #eee;
  position: sticky;
  top: 0;
}

nav a {
  margin-right: 1.5rem;
  text-decoration: none;
  color: #555;
  font-weight: 500;
  transition: color 0.2s;
}

nav a:hover {
  color: #0066cc;
}

main {
  flex: 1;
  padding: 3rem 2rem;
  max-width: 720px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

h1 {
  font-size: 2rem;
  margin-bottom: 1rem;
}

a {
  color: #0066cc;
}

ul {
  padding-left: 1.2rem;
}

li {
  margin-bottom: 0.8rem;
}

footer {
  padding: 1.5rem 2rem;
  border-top: 1px solid #eee;
  text-align: center;
  color: #999;
  font-size: 0.9rem;
  background: #fff;
}
</style>