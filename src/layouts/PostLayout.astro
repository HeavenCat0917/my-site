---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;
const isProjects = Astro.url.pathname.startsWith('/projects');
---

<Layout title={frontmatter.title}>
  <article>
    <h1>{frontmatter.title}</h1>
    <p class="meta">
      {frontmatter.date}
      {frontmatter.tech && ` · ${frontmatter.tech}`}
    </p >
    <slot />
    {isProjects ? (
      <p><a href=" ">← 返回作品列表</a ></p >
    ) : (
      <p><a href="/blog">← 返回文章列表</a ></p >
    )}
  </article>
</Layout>

<style>
  .meta {
    color: #999;
    font-size: 0.9rem;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }
  article :global(h2) {
    margin-top: 2rem;
  }
  article :global(code) {
    background: #f0f0f0;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  article :global(pre) {
    background: #1e1e1e;
    color: #eee;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
  }
</style>