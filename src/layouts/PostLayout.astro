---
import Layout from './Layout.astro';

const { frontmatter } = Astro.props;

const path = Astro.url.pathname;

const backLink = path.startsWith('/projects')
? { href: '/projects' , label: '← 返回作品列表'}
: path.startsWith('/poem')
? { href: '/poem', label: '← 返回诗歌列表' }
: { href: '/blog', label: '← 返回文章列表' };
---

<Layout title={frontmatter.title}>
  <article>
    <h1>{frontmatter.title}</h1>
    <p class="meta">
      {frontmatter.date?.slice(0, 10)}
      {frontmatter.tech && ` · ${frontmatter.tech}`}
    </p >
    <slot />
    <p><a href={backLink.href}>{backLink.label}</a></p>
  </article>
</Layout>

<style>
  .meta {
    color: #999;
    font-size: 0.9rem;
    margin-top: -0.5rem;
    margin-bottom: 2rem;
  }
  article :global(p) {
    text-indent: 2em;
  }
  article :global(blockquote p) {
    text-indent: 0;
  }
  article :global(blockquote) {
    border-left: 4px solid #ddd;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #666;
    font-style: italic;
  }
  article :global(h2) {
    margin-top: 2rem;
  }
  article :global(code) {
    background: #f0f0f0;
    padding: 0.15em 0.4em;
    border-radius: 4px;
    font-size: 0.9em;
  }
  article :global(pre) {
    background: #1e1e1e;
    color: #eee;
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
  }
</style>